# Copy to .env and fill in — .env is gitignored, never commit real tokens.
# Used by scripts/upload_results.sh (Hugging Face Hub uploads).

# Hugging Face write token (https://huggingface.co/settings/tokens)
HUGGINGFACE_HUB_TOKEN=

# Target repo for uploaded experiment artifacts / checkpoints
HF_REPO_ID=your-username/deeppvmapper-backbones

# Create the upload repo as public instead of private (default: private until
# dataset licensing for weight release is confirmed)
# HF_PRIVATE=0
